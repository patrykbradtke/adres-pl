DATABASE_URL=postgres://adres:adres@localhost:5432/adres
# Sciezka lokalna albo URL http(s) do artefaktu indeksu
INDEX_SOURCE=./data/index/current.bin
# Wskaznik wersji - loader odpytuje go i podmienia indeks bez restartu
INDEX_POINTER=./data/index/current.json
INDEX_POLL_MS=60000
ARCHIVE_ROOT=./data/archive
INDEX_ROOT=./data/index
RATE_LIMIT_MAX=600
# Limitowanie idzie po adresie klienta. Za ingressem podac liczbe przeskokow
# (np. 1) albo liste CIDR zaufanych proxy - bez tego caly ruch trafia do
# jednego kubelka po adresie ingressu. Domyslnie wylaczone: gdy proces stoi
# bezposrednio na porcie, wlaczenie pozwala klientowi podac wlasny adres.
TRUST_PROXY=
CORS_ORIGIN=
LOG_LEVEL=info

# --- Klucze API (etap 8A) ---------------------------------------------
#
# UWAGA: nic w projekcie nie wczytuje pliku .env. Zmienne podaje sie z powloki,
# przez sekcje environment w docker-compose albo przez sekret Kubernetesa
# (wzorzec: deploy/cronjob.yaml, secretKeyRef). Ten plik jest WZORCEM
# do skopiowania i opisem znaczenia, nie zrodlem konfiguracji.

# Pieprz do skrotow kluczy API - HMAC-SHA256. Trzymany POZA baza celowo:
# dzieki temu zrzut bazy, replika ani kopia zapasowa nie wystarcza do
# rozwiazania skrotow. Zrzut zawiera same skroty, nigdy klucze.
#
# UTRATA PIEPRZA = UNIEWAZNIENIE WSZYSTKICH KLUCZY, bez mozliwosci
# odtworzenia z kopii bazy. Kopia pieprza nalezy do zadania 8.22.
#
# Numerowane, bo instancja zna wiele wersji naraz i sprawdza klucz kazda
# z nich - to warunek rotacji bez przerwy w dzialaniu. Nowy sekret:
#   node --experimental-strip-types -e "import('./packages/api/src/keys/pepper.ts').then(m=>console.log(m.newPepperSecret()))"
API_KEY_PEPPER_1=
# Wersja uzywana do skrotow NOWYCH kluczy. Domyslnie najwyzsza obecna.
API_KEY_PEPPER_AKTYWNY=1
