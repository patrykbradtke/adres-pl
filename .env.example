DATABASE_URL=postgres://adres:adres@localhost:5432/adres
# Sciezka lokalna albo URL http(s) do artefaktu indeksu
INDEX_SOURCE=./data/index/current.bin
# Wskaznik wersji - loader odpytuje go i podmienia indeks bez restartu
INDEX_POINTER=./data/index/current.json
INDEX_POLL_MS=60000
ARCHIVE_ROOT=./data/archive
INDEX_ROOT=./data/index
RATE_LIMIT_MAX=600
CORS_ORIGIN=
LOG_LEVEL=info
