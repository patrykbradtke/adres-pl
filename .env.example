DATABASE_URL=postgres://adres:adres@localhost:5432/adres
# Sciezka lokalna albo URL http(s) do artefaktu indeksu
INDEX_SOURCE=./data/index/current.bin
# Wskaznik wersji - loader odpytuje go i podmienia indeks bez restartu
INDEX_POINTER=./data/index/current.json
INDEX_POLL_MS=60000
ARCHIVE_ROOT=./data/archive
INDEX_ROOT=./data/index
RATE_LIMIT_MAX=600
# Limitowanie idzie po adresie klienta. Za ingressem podac liczbe przeskokow
# (np. 1) albo liste CIDR zaufanych proxy - bez tego caly ruch trafia do
# jednego kubelka po adresie ingressu. Domyslnie wylaczone: gdy proces stoi
# bezposrednio na porcie, wlaczenie pozwala klientowi podac wlasny adres.
TRUST_PROXY=
CORS_ORIGIN=
LOG_LEVEL=info

# --- Klucze API (etap 8A) ---------------------------------------------
#
# UWAGA: nic w projekcie nie wczytuje pliku .env. Zmienne podaje sie z powloki,
# przez sekcje environment w docker-compose albo przez sekret Kubernetesa
# (wzorzec: deploy/cronjob.yaml, secretKeyRef). Ten plik jest WZORCEM
# do skopiowania i opisem znaczenia, nie zrodlem konfiguracji.

# Tryb uwierzytelniania. Trzy stany, celowo, zeby wlaczenie bylo osobna
# i odwracalna decyzja:
#   wylaczony  - ruch bez klucza dziala jak dotad, rejestr kluczy nie rusza
#   opcjonalny - klucz honorowany, gdy jest; bez niego limit po adresie
#   wymagany   - brak klucza konczy sie kodem 401
API_KEY_MODE=wylaczony

# Limit na minute z JEDNEGO ADRESU dla ruchu bez waznego klucza. Chroni przed
# zgadywaniem kluczy: zadanie odrzucone w onRequest nie dochodzi do limitera
# trasy, wiec bez tego proby bylyby calkowicie nielimitowane.
RATE_LIMIT_NIEUWIERZYTELNIONY=60

# Co ile odpytywac baze o zmiany w kluczach. NOTIFY jest przyspieszaczem
# (zbieznosc ok. 25 ms), a to jest GWARANCJA: powiadomienie ginie cicho przy
# restarcie bazy albo przelaczeniu na replike.
KLUCZE_ODSWIEZANIE_MS=10000

# Po ilu sekundach bez udanego odswiezenia repliki instancja przestaje meldowac
# gotowosc. Uwierzytelnianie dziala DALEJ z repliki (fail-open) - to jest decyzja
# o kierowaniu ruchu, nie o wpuszczaniu klientow. Gdy baza padnie globalnie,
# wszystkie instancje wypadaja z ruchu i awaria staje sie widoczna, zamiast byc
# po cichu tolerowana godzinami. Patrz docs/runbook-klucze.md.
KLUCZE_MAX_WIEK_S=900

# Co ile zrzucac agregat zuzycia do bazy. Zapis jest ZBIORCZY, bo pojedynczy
# UPDATE na goracej sciezce sam przekroczylby prog "+0,3 ms do p99" z zadania 8.8.
# Kontrola kwoty dolicza jednostki jeszcze niezrzucone, wiec nadmiar jest
# ograniczony jednym zadaniem, a nie calym oknem zrzutu.
ZUZYCIE_FLUSH_MS=60000

# Pieprz do skrotow kluczy API - HMAC-SHA256. Trzymany POZA baza celowo:
# dzieki temu zrzut bazy, replika ani kopia zapasowa nie wystarcza do
# rozwiazania skrotow. Zrzut zawiera same skroty, nigdy klucze.
#
# UTRATA PIEPRZA = UNIEWAZNIENIE WSZYSTKICH KLUCZY, bez mozliwosci
# odtworzenia z kopii bazy. Kopia pieprza nalezy do zadania 8.22.
#
# Numerowane, bo instancja zna wiele wersji naraz i sprawdza klucz kazda
# z nich - to warunek rotacji bez przerwy w dzialaniu. Nowy sekret:
#   node --experimental-strip-types -e "import('./packages/api/src/keys/pepper.ts').then(m=>console.log(m.newPepperSecret()))"
API_KEY_PEPPER_1=
# Wersja uzywana do skrotow NOWYCH kluczy. Domyslnie najwyzsza obecna.
API_KEY_PEPPER_AKTYWNY=1

# Token operatora do tras /admin.
#
# PUSTY = trasy w ogole nie trafiaja do routera, wiec instancja publiczna nie ma
# czego wystawiac. Mechanizm ODREBNY od kluczy klienckich: klucz adr_live_* nie
# otwiera zadnej trasy /admin, bo bylaby to eskalacja uprawnien z klienta na
# operatora.
#
# Wymagane co najmniej 32 znaki i wartosc nieoczywista - start konczy sie
# bledem przy krotszym. Zgadniecie tego tokenu omija CALY etap 8A w jednym
# kroku, bo pozwala wystawic sobie klucz bez limitow. Wygeneruj poleceniem
# podanym w docs/runbook-klucze.md.
ADMIN_TOKEN=
